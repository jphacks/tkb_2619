# 必要なものだけ .env.local にコピーして設定する（.env.local は git に含めない）

# Supabase（招待URLで複数の端末からルームを共有する）。未設定だと同じブラウザ内だけのデモモードで動く
# Project Settings → API の「Project URL」と「anon public」キー。service_role キーは絶対に置かないこと
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 別のSpotifyアプリを使う場合だけ設定（未設定ならチームのClient IDを使う）。Client Secretは不要
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
